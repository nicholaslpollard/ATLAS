ATLAS_ENV=development

OPENAI_API_KEY=
DATABASE_URL=

# ============================================================
# MASSIVE - PRIMARY MARKET DATA
# ============================================================
MASSIVE_API_KEY=
MASSIVE_S3_ACCESS_KEY_ID=
MASSIVE_S3_SECRET_ACCESS_KEY=
MASSIVE_ENDPOINT=https://files.massive.com


# ============================================================
# SEC EDGAR - READ-ONLY REGULATORY SOURCE
# ============================================================
# Required for declared automated access under SEC fair-access guidance.
# Keep the real contact address only in the local .env; never commit it.
SEC_EDGAR_CONTACT_EMAIL=


# ============================================================
# WEBULL - PRIMARY BROKER
# ============================================================

# Paper / Sandbox
WEBULL_PAPER_APP_KEY=
WEBULL_PAPER_APP_SECRET=

# Live / Production
WEBULL_LIVE_APP_KEY=
WEBULL_LIVE_APP_SECRET=


# ============================================================
# ALPACA - SECONDARY BROKER
# ============================================================
#ALPACa_Security_Code=
# Paper Trading
ALPACA_PAPER_ENDPOINT=https://paper-api.alpaca.markets/v2
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=

# Live Trading
ALPACA_LIVE_ENDPOINT=https://api.alpaca.markets
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_API_SECRET=


# ============================================================
# IBKR - OPTIONAL DATA FALLBACK
# ============================================================
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=17
