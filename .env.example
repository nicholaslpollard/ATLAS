# ATLAS environment. Valid values: development, shadow, approval, live
ATLAS_ENV=development

# Optional explicit project root. Normally unnecessary when running from the repo.
# ATLAS_ROOT=C:\\ATLAS

# ============================================================
# MARKET DATA - MASSIVE
# Keep all credential values in local .env only.
# ============================================================
MASSIVE_API_KEY=
MASSIVE_S3_ACCESS_KEY_ID=
MASSIVE_S3_SECRET_ACCESS_KEY=

# ============================================================
# WEBULL - PRIMARY BROKER (PAPER / SANDBOX)
# Phase 17+ accepted code uses the sandbox endpoint internally.
# Account selection is explicit and fail-closed when ambiguous.
# ============================================================
WEBULL_PAPER_APP_KEY=
WEBULL_PAPER_APP_SECRET=
WEBULL_PAPER_ACCOUNT_ID=

# ============================================================
# ALPACA - SECONDARY BROKER (PAPER)
# AlpacaPaperBroker forces paper mode internally.
# ============================================================
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=

# ============================================================
# APPLICATION / FUTURE OPERATIONAL SERVICES
# ============================================================
OPENAI_API_KEY=
DATABASE_URL=

# Live broker credentials are intentionally not templated as active
# configuration until a separately accepted live-authority phase exists.
