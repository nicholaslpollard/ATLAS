# --- Environment / Secrets ---
# Never commit your private API keys, database credentials, or secret tokens
.env
*.env
.env.local

# --- Visual Studio Code Settings ---
# Ignores local editor configurations but keeps shared tasks/extensions if you need them
.vscode/
!.vscode/extensions.json
!.vscode/tasks.json
*.code-workspace

# --- Dependencies & Build Tools ---
# Heavy, auto-generated folders that can be reinstalled locally
node_modules/
dist/
build/
out/
.pnpm-store/
.yarn/

# --- Operating System Junk ---
# Local system configurations generated by Windows/macOS
Thumbs.db
Desktop.ini
.DS_Store
.AppleDouble
.LSOverride

# --- Logs and Diagnostics ---
# Log files generated during development runtimes
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
